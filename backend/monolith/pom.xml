<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.6</version>
		<relativePath/>
	</parent>
	<groupId>com.notenest</groupId>
	<artifactId>monolith</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>monolith</name>
	<description>Build gabungan NoteNest untuk deploy di free tier (1 service)</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2024.0.1</spring-cloud.version>
		<!-- override: byte-buddy bawaan Spring Boot 3.4.6 belum mengenali bytecode JDK 25 -->
		<byte-buddy.version>1.18.12</byte-buddy.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
			<version>2.7.0</version>
		</dependency>

		<!-- Eureka dan Config Client SENGAJA tidak ada: satu proses tidak perlu
		     menemukan dirinya sendiri. OpenFeign masuk hanya sebagai TIPE, bukan
		     sebagai mekanisme - interface UserClient tetap dikompilasi apa adanya
		     (@FeignClient) dan NoteServiceImpl masih menyebut FeignException di
		     blok catch-nya. Tanpa @EnableFeignClients, anotasi itu tidak berarti
		     apa-apa: tidak ada proxy HTTP yang dibuat, dan satu-satunya bean
		     bertipe UserClient adalah LocalUserClient. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-openfeign-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.5</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.5</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.5</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Smoke test menjalankan seluruh context gabungan di H2, jadi bean ganda
		     atau rantai security yang putus ketahuan tanpa perlu PostgreSQL hidup. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Modul ini TIDAK menyalin kode. Ia mengompilasi source milik
			     auth/user/note langsung dari foldernya, jadi logika bisnis tetap
			     punya satu sumber kebenaran: perbaikan di service asli otomatis
			     ikut ke build gabungan ini. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>add-service-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../auth-service/src/main/java</source>
								<source>${project.basedir}/../user-service/src/main/java</source>
								<source>${project.basedir}/../note-service/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
					<!-- Kelas yang hanya masuk akal kalau tiap service jalan sendiri-sendiri.
					     Semuanya punya pengganti tunggal di com.notenest.monolith.*

					     PENTING: pola exclude dicocokkan relatif terhadap SETIAP source
					     root, termasuk src/main/java milik modul ini. Karena itu tiap pola
					     harus menyebut paket service-nya (authservice/userservice/noteservice).
					     Pola longgar seperti **/exception/GlobalExceptionHandler.java ikut
					     membuang file pengganti milik monolith sendiri - dan javac diam saja,
					     karena file yang di-exclude masih bisa ikut terkompilasi lewat
					     sourcepath tanpa menjalankan Lombok. -->
					<excludes>
						<!-- 3 @SpringBootApplication -> diganti MonolithApplication -->
						<exclude>com/notenest/authservice/AuthServiceApplication.java</exclude>
						<exclude>com/notenest/userservice/UserServiceApplication.java</exclude>
						<exclude>com/notenest/noteservice/NoteServiceApplication.java</exclude>
						<!-- 3 @EnableJpaAuditing -> pindah ke MonolithApplication -->
						<exclude>com/notenest/authservice/config/JpaConfig.java</exclude>
						<exclude>com/notenest/userservice/config/JpaConfig.java</exclude>
						<exclude>com/notenest/noteservice/config/JpaConfig.java</exclude>
						<!-- 3 @RestControllerAdvice dengan handler yang tumpang tindih -> digabung -->
						<exclude>com/notenest/authservice/exception/GlobalExceptionHandler.java</exclude>
						<exclude>com/notenest/userservice/exception/GlobalExceptionHandler.java</exclude>
						<exclude>com/notenest/noteservice/exception/GlobalExceptionHandler.java</exclude>
						<!-- Rantai security & verifikasi token jadi satu pintu -->
						<exclude>com/notenest/authservice/security/SecurityConfig.java</exclude>
						<exclude>com/notenest/authservice/security/JwtAuthFilter.java</exclude>
						<!-- Tidak ada pemanggil HTTP antar-service lagi -->
						<exclude>com/notenest/userservice/controller/InternalUserController.java</exclude>
					</excludes>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
