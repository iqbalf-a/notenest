# Salin jadi .env (sudah di-gitignore), lalu isi nilainya.
# Dipakai docker-compose.monolith.yml.

DB_NAME=notenest_db
DB_USER=notenest
DB_PASSWORD=ganti-dengan-password-sendiri

# Wajib Base64 dan minimal 32 byte setelah didecode. Bikin satu:
#   openssl rand -base64 48
JWT_SECRET=ganti-dengan-hasil-openssl-rand-base64-48

# Origin frontend yang boleh memanggil API dari browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173
